{
  "name": "intentlock",
  "version": "0.1.0",
  "private": true,
  "description": "Verify that a patch stays within its authorized change scope.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "intentlock": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint src tests && prettier --check package.json tsconfig.json eslint.config.js .prettierrc.json tsup.config.ts src tests README.md changelog.md docs examples .github/workflows/ci.yml",
    "test": "tsup --config tsup.config.ts && vitest run --testTimeout 15000",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "commander": "^13.1.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
